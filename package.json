{
  "name": "em-verse",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": "https://github.com/derekdylu/em-verse.git",
  "author": "derekdylu",
  "license": "MIT",
  "scripts": {
    "frontend": "yarn workspace @em-verse/frontend dev",
    "server": "yarn workspace @em-verse/backend dev",
    "build": "yarn workspace @em-verse/frontend build",
    "test": "yarn workspace @em-verse/backend test && yarn workspace @em-verse/frontend test --run",
    "audit": "yarn audit --groups dependencies"
  }
}
